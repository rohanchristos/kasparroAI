# ============================================================
# Kasparro AI Customer Support Agent — Environment Variables
# ============================================================

# ── LLM Providers ───────────────────────────────────────────
# You only need to provide keys for the models you intend to use.
# Grok is used as the default fast/free tier model.
GROK_API_KEY="your-grok-api-key"
OPENAI_API_KEY="your-openai-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# ── Gmail OAuth2 Credentials ────────────────────────────────
# Required for the agent to fetch incoming emails and send replies.
# Setup instructions: Google Cloud Console -> APIs & Services -> Credentials
GMAIL_CLIENT_ID="your-google-cloud-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-google-cloud-client-secret"
GMAIL_REFRESH_TOKEN="your-oauth-refresh-token"

# ── Security & Authentication ───────────────────────────────
# Used by Node.js to sign JWTs and FastAPI to verify them.
# In production, change this to a long random string.
JWT_SECRET="super-secret-development-jwt-key"

# ── Database & Cache ────────────────────────────────────────
# Default settings map directly to the docker-compose.yml services.
# Do not change these unless running outside of Docker.
DATABASE_URL="postgresql://kasparro_admin:kasparro_password@postgres:5432/kasparro_db"
REDIS_URL="redis://redis:6379"

# ── Application Configuration ───────────────────────────────
LOG_LEVEL="INFO"
CORS_ORIGINS="http://localhost:3000,http://localhost"
BACKEND_URL="http://nodejs:5000"
EMAIL_POLL_INTERVAL=60
